{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NH-Media",
  "version": "0.1.0",
  "identifier": "com.nhathao.nhmedia",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node apps/desktop/scripts/build-frontend.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "NH-Media", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 http://localhost:8080; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
