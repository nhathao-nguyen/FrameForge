# Copy to a local, uncommitted environment file or set these variables in PowerShell.
# Values below are placeholders only; replace every CHANGE_ME value before starting services.
NH_MEDIA_PROFILE=local
NH_MEDIA_BIND_HOST=127.0.0.1

POSTGRES_DB=nh_media
POSTGRES_SUPERUSER=nh_media_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_ADMIN
POSTGRES_APP_USER=nh_media_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP
POSTGRES_MIGRATION_USER=nh_media_migrator
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_POSTGRES_MIGRATOR
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379

MINIO_ROOT_USER=nh_media_storage
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT
MINIO_BUCKET=nh-media-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

NH_API_BIND=127.0.0.1:8080
NH_API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NH_API_ADMIN_USERNAME=admin
NH_API_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN
NH_API_SESSION_SECRET=CHANGE_ME_LOCAL_SESSION_SECRET
NH_API_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_MASTER_KEY

NH_MEDIA_FFMPEG_PATH=
NH_MEDIA_FFPROBE_PATH=
NH_MEDIA_MAX_CONCURRENCY=1
NH_ML_MAX_CONCURRENCY=1
NH_PROVIDER_DEFAULT_TIMEOUT=30s
NH_STORAGE_BACKEND=s3
NH_STORAGE_ENDPOINT=http://127.0.0.1:9000
NH_STORAGE_ACCESS_KEY=
NH_STORAGE_SECRET_KEY=
NH_STORAGE_BUCKET=nh-media-artifacts
NH_STORAGE_LOCAL_ROOT=
NH_STORAGE_CACHE_ROOT=
NH_QUEUE_ENDPOINT=redis://127.0.0.1:6379
NH_QUEUE_PASSWORD=
NH_QUEUE_STREAM_PREFIX=nh-media
NH_QUEUE_CONSUMER_GROUP=nh-media-workers
NH_MEDIA_REDIS_WORKER=0
NH_MEDIA_QUEUE_CAPABILITY=analysis
NH_MEDIA_WORKER_CONSUMER=ml-worker-1
